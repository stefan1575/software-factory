{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc && tsc -p window",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"test/*.test.ts\" && vitest run --root window",
    "desktop:build": "vite build window --logLevel warn && esbuild desktop/main.ts --bundle --platform=node --format=esm --external:electron --outfile=dist/main.mjs --log-level=warning",
    "desktop": "npm run desktop:build && electron ."
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "main": "dist/main.mjs"
}
